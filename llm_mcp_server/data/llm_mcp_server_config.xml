<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Default MCP server configuration for a fresh database.
        noupdate keeps later module upgrades from resetting administrator
        settings. Existing databases are marked noupdate by
        migrations/18.0.1.6.1/pre-migrate.py before this file reloads.
    -->
    <record id="default_mcp_server_config" model="llm.mcp.server.config">
        <field name="name">odoo_llm_mcp_server</field>
        <field name="version">1.0.0</field>
        <field name="latest_protocol_version">2025-11-25</field>
        <field
            name="supported_protocol_versions"
            eval="['2025-06-18', '2025-03-26', '2024-11-05']"
        />
        <field name="active" eval="True" />
        <field name="endpoint_path">/mcp</field>

        <!-- Server Mode Configuration -->
        <field name="mode">stateful</field>
        <field name="tool_mode">all</field>
        <field name="oauth_enabled" eval="True"/>
        <field name="allow_api_key" eval="True"/>

        <!-- External URL left empty for auto-detection from web.base.url -->
        <field name="external_url" />
    </record>
</odoo>
