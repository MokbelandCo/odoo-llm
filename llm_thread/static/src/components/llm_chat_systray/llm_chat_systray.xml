<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_thread.LLMChatSystray">
        <!-- Wrapper matches other systray items so navbar flex/height apply. -->
        <div>
            <button
        class="o-llm-Systray-toggler o_nav_entry"
        type="button"
        t-on-click="onClick"
        t-att-title="title"
        t-att-aria-label="ariaLabel"
        t-att-aria-pressed="popupHub.hasOpenWindows ? 'true' : 'false'"
      >
                <i class="fa fa-lg fa-magic" role="img" />
            </button>
        </div>
    </t>
</templates>
