<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_llm_mcp_oauth_client_secret_show_form" model="ir.ui.view">
        <field name="name">llm.mcp.oauth.client.secret.show.form</field>
        <field name="model">llm.mcp.oauth.client.secret.show</field>
        <field name="arch" type="xml">
            <form string="Client Secret Ready" create="false" edit="false">
                <sheet>
                    <h3 class="fw-bold">Write down your client secret</h3>
                    <p>
                        Use this secret with Client Secret Post or Client Secret Basic
                        when calling the token endpoint. Public apps such as Cursor
                        should keep None (public / PKCE) and should not use a secret.
                    </p>
                    <group>
                        <field
                            name="client_id"
                            readonly="1"
                            widget="CopyClipboardChar"
                        />
                        <field
                            name="client_secret"
                            readonly="1"
                            widget="CopyClipboardChar"
                        />
                        <field name="token_endpoint_auth_method" readonly="1"/>
                    </group>
                    <p class="alert alert-warning" role="alert">
                        <strong>Important:</strong>
                        This secret cannot be retrieved later. Store it securely
                        before closing this dialog. Rotating replaces the previous
                        secret; existing access tokens stay valid until they expire.
                    </p>
                </sheet>
                <footer>
                    <button
                        special="cancel"
                        data-hotkey="x"
                        string="Done"
                        class="btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_llm_mcp_oauth_client_secret_show" model="ir.actions.act_window">
        <field name="name">Client Secret Ready</field>
        <field name="res_model">llm.mcp.oauth.client.secret.show</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
